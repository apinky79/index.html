{
  "extends": "@marketdna/typescript-config/react.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "dist", "dist-electron", "node_modules"]
}
