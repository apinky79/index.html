{
  "name": "@marketdna/database",
  "version": "0.2.0",
  "private": true,
  "description": "MarketDNA persistence — optimisation import store (SQLite metadata index + NDJSON trials)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist coverage",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@marketdna/domain": "workspace:*",
    "@marketdna/import-engine": "workspace:*",
    "@marketdna/shared": "workspace:*"
  },
  "devDependencies": {
    "@marketdna/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
